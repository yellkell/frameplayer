From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FramePlayer contributors <noreply@example.invalid>
Date: Sat, 3 Oct 2026 20:30:00 +0000
Subject: [PATCH 7/7] xr: hooks for a host app that embeds the browser

FramePlayer shows Chromium XR's pages inside its own VR panels: the browser
runs without a visible window, driven over DevTools. Two things stop WebXR
working there. The consent prompt for immersive sessions has no visible UI
to answer it, so every session was denied ("The user denied some part of
the requested configuration"). And only one OpenXR app can drive the
headset, so the host must release it before the page's session starts and
take it back after.

With --xr-host-handoff=DIR (absent: no change in behaviour):
- immersive-session permissions are granted without a prompt;
- before an immersive session starts, Chromium writes DIR/xr-request and
  waits (off the UI thread, at most 8 s) for the host's DIR/xr-ready;
- when the session ends, or fails to start, it writes DIR/xr-ended.

Verified on a Steam Frame with a fresh profile (no saved permissions),
Fish & Chips driven over DevTools: no prompt; xr-request appeared and the
session started after the 8 s timeout with no host, or 58 ms after the
host wrote xr-ready; leaving the session wrote xr-ended.

Bug: none
---
 content/browser/xr/service/vr_service_impl.cc | 75 +++++++++++++++++++++++++++
 content/browser/xr/service/vr_service_impl.h  |  3 ++
 2 files changed, 78 insertions(+)

diff --git a/content/browser/xr/service/vr_service_impl.cc b/content/browser/xr/service/vr_service_impl.cc
index 32ba0f88d9..d0582a81a9 100644
--- a/content/browser/xr/service/vr_service_impl.cc
+++ b/content/browser/xr/service/vr_service_impl.cc
@@ -8,7 +8,12 @@
 #include <utility>
 #include <vector>
 
+#include "base/command_line.h"
 #include "base/containers/to_vector.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/platform_thread.h"
 #include "base/dcheck_is_on.h"
 #include "base/feature_list.h"
 #include "base/functional/bind.h"
@@ -63,6 +68,52 @@ device::mojom::XRRuntimeSessionOptionsPtr GetRuntimeOptions(
   return runtime_options;
 }
 
+// --xr-host-handoff=DIR: Chromium XR is embedded in a host app that owns
+// the headset while no immersive session runs (FramePlayer on the Steam
+// Frame; only one OpenXR app can drive the headset). Immersive sessions are
+// then granted without a consent prompt (the host shows the page; there is
+// no visible browser UI to answer one), and handed over through files in
+// DIR: Chromium writes "xr-request" and waits up to 8 s for the host's
+// "xr-ready" (written once it has released the headset) before starting
+// the session, and writes "xr-ended" when the session ends or fails, so
+// the host can take the headset back.
+constexpr char kXrHostHandoffSwitch[] = "xr-host-handoff";
+constexpr base::TimeDelta kXrHostHandoffTimeout = base::Seconds(8);
+
+base::FilePath XrHostHandoffDir() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+      kXrHostHandoffSwitch);
+}
+
+// Thread pool (may block): asks the host for the headset and waits for it.
+void WaitForXrHostHandoff(const base::FilePath& dir) {
+  const base::FilePath ready = dir.AppendASCII("xr-ready");
+  base::DeleteFile(ready);
+  base::DeleteFile(dir.AppendASCII("xr-ended"));
+  base::WriteFile(dir.AppendASCII("xr-request"), "1");
+  const base::TimeTicks deadline =
+      base::TimeTicks::Now() + kXrHostHandoffTimeout;
+  while (!base::PathExists(ready) && base::TimeTicks::Now() < deadline) {
+    base::PlatformThread::Sleep(base::Milliseconds(50));
+  }
+  base::DeleteFile(dir.AppendASCII("xr-request"));
+}
+
+// Thread pool (may block): tells the host the headset is free again.
+void NotifyXrHostSessionEnded(const base::FilePath& dir) {
+  base::DeleteFile(dir.AppendASCII("xr-ready"));
+  base::WriteFile(dir.AppendASCII("xr-ended"), "1");
+}
+
+void NotifyXrHostSessionEndedIfEmbedded() {
+  base::FilePath dir = XrHostHandoffDir();
+  if (!dir.empty()) {
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&NotifyXrHostSessionEnded, std::move(dir)));
+  }
+}
+
 // Helper, returns collection of permissions required for XR session creation
 // for session with mode set to |mode|. The order in the result does not matter
 // as the permissions API does not honor it.
@@ -399,6 +450,7 @@ void VRServiceImpl::OnImmersiveSessionCreated(
     TRACE_EVENT("xr",
                 "VRServiceImpl::OnImmersiveSessionCreated: no session_result",
                 perfetto::Flow::Global(request.options->trace_id));
+    NotifyXrHostSessionEndedIfEmbedded();
 
     RejectSession(std::move(request.callback), request.options->trace_id,
                   device::mojom::RequestSessionError::UNKNOWN_RUNTIME_ERROR,
@@ -598,6 +650,14 @@ void VRServiceImpl::DoRequestPermissions(
     const std::vector<blink::PermissionType> request_permissions,
     base::OnceCallback<void(const std::vector<blink::mojom::PermissionStatus>&,
                             bool)> result_callback) {
+  if (!XrHostHandoffDir().empty()) {
+    std::move(result_callback)
+        .Run(std::vector<blink::mojom::PermissionStatus>(
+                 request_permissions.size(),
+                 blink::mojom::PermissionStatus::GRANTED),
+             /*needs_prompt=*/false);
+    return;
+  }
   PermissionController* permission_controller =
       GetWebContents()->GetBrowserContext()->GetPermissionController();
   CHECK(permission_controller);
@@ -845,6 +905,20 @@ void VRServiceImpl::OnInstallResult(SessionRequestData request,
 }
 
 void VRServiceImpl::DoRequestSession(SessionRequestData request) {
+  base::FilePath handoff_dir = XrHostHandoffDir();
+  if (!handoff_dir.empty() &&
+      device::XRSessionModeUtils::IsImmersive(request.options->mode)) {
+    base::ThreadPool::PostTaskAndReply(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&WaitForXrHostHandoff, std::move(handoff_dir)),
+        base::BindOnce(&VRServiceImpl::DoRequestSessionNow,
+                       weak_ptr_factory_.GetWeakPtr(), std::move(request)));
+    return;
+  }
+  DoRequestSessionNow(std::move(request));
+}
+
+void VRServiceImpl::DoRequestSessionNow(SessionRequestData request) {
   DVLOG(2) << __func__;
   // Get the runtime again, since we're running in an async context
   // and the pointer returned from `GetRuntimeForOptions` is non-owning.
@@ -990,6 +1064,7 @@ void VRServiceImpl::OnExitPresent() {
         ->OnXrHasRenderTarget(default_frame_sink_id);
 
     if (has_immersive_session_) {
+      NotifyXrHostSessionEndedIfEmbedded();
       render_frame_host_->GetProcess()->OnImmersiveXrSessionStopped();
       GetSessionMetricsHelper()->StopAndRecordImmersiveSession();
       has_immersive_session_ = false;
diff --git a/content/browser/xr/service/vr_service_impl.h b/content/browser/xr/service/vr_service_impl.h
index 33e228771c..c27d14b92c 100644
--- a/content/browser/xr/service/vr_service_impl.h
+++ b/content/browser/xr/service/vr_service_impl.h
@@ -172,6 +172,9 @@ class CONTENT_EXPORT VRServiceImpl : public device::mojom::VRService,
   void OnInstallResult(SessionRequestData request_data, XrInstallResult result);
 
   void DoRequestSession(SessionRequestData request);
+  // DoRequestSession once the host app (--xr-host-handoff) has released the
+  // headset, or straight away without one.
+  void DoRequestSessionNow(SessionRequestData request);
 
   void OnInlineSessionCreated(
       SessionRequestData request,
