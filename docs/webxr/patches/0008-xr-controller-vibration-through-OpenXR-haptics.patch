+void OpenXRInputHelper::ApplyHapticFeedback(uint32_t source_id,
+                                            float amplitude,
+                                            base::TimeDelta duration) {
+  // Source ids are the controller index plus one; see GetInputState().
+  if (source_id == 0 || source_id > controller_states_.size()) {
+    return;
+  }
+  XrResult result =
+      controller_states_[source_id - 1].controller.ApplyHapticFeedback(
+          amplitude, duration);
+  VLOG(1) << __func__ << " source " << source_id << " amplitude " << amplitude
+          << " duration " << duration << ": " << result;
+}
