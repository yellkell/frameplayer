+GamepadHapticActuator* XRInputSource::GetVibrationActuatorForGamepad(
+    const Gamepad&) {
+  // Only immersive sessions talk to a device that can vibrate controllers.
+  if (!session_->immersive()) {
+    return nullptr;
+  }
+  if (!vibration_actuator_) {
+    LocalDOMWindow* window = session_->xr()->DomWindow();
+    if (!window) {
+      return nullptr;
+    }
+    vibration_actuator_ = MakeGarbageCollected<GamepadHapticActuator>(
+        *window, this, device::GamepadHapticActuatorType::kDualRumble);
+  }
+  return vibration_actuator_.Get();
+}
+
+void XRInputSource::PlayVibrationEffectOnce(
+    device::mojom::GamepadHapticEffectType type,
+    device::mojom::blink::GamepadEffectParametersPtr params,
+    GamepadHapticActuator::Delegate::Callback callback) {
+  if (pending_haptic_callback_) {
+    // The new effect replaces the one playing.
+    std::move(pending_haptic_callback_)
+        .Run(device::mojom::GamepadHapticsResult::GamepadHapticsResultPreempted);
+  }
+  LocalDOMWindow* window = session_->xr()->DomWindow();
+  if (type != device::mojom::GamepadHapticEffectType::
+                  GamepadHapticEffectTypeDualRumble ||
+      session_->ended() || !window) {
+    std::move(callback).Run(
+        device::mojom::GamepadHapticsResult::GamepadHapticsResultNotSupported);
+    return;
+  }
+
+  // XR controllers have a single actuator: play the stronger of the two
+  // rumble magnitudes.
+  const float amplitude = static_cast<float>(
+      std::max(params->strong_magnitude, params->weak_magnitude));
+  const base::TimeDelta start_delay = base::Milliseconds(params->start_delay);
+  const base::TimeDelta duration = base::Milliseconds(params->duration);
+  const uint32_t effect_id = ++haptic_effect_id_;
+  pending_haptic_callback_ = std::move(callback);
+
+  scoped_refptr<base::SingleThreadTaskRunner> task_runner =
+      window->GetTaskRunner(TaskType::kMiscPlatformAPI);
+  task_runner->PostDelayedTask(
+      FROM_HERE,
+      blink::BindOnce(&XRInputSource::StartHapticEffect,
+                      WrapWeakPersistent(this), effect_id, amplitude, duration),
+      start_delay);
+  task_runner->PostDelayedTask(
+      FROM_HERE,
+      blink::BindOnce(&XRInputSource::OnHapticEffectEnded,
+                      WrapWeakPersistent(this), effect_id),
+      start_delay + duration);
+}
+
+void XRInputSource::ResetVibrationActuator(
+    GamepadHapticActuator::Delegate::Callback callback) {
+  if (pending_haptic_callback_) {
+    // Cancel the pending tasks of the effect, and stop it.
+    ++haptic_effect_id_;
+    std::move(pending_haptic_callback_)
+        .Run(device::mojom::GamepadHapticsResult::GamepadHapticsResultPreempted);
+    SendHapticFeedback(0.0f, base::TimeDelta());
+  }
+  std::move(callback).Run(
+      device::mojom::GamepadHapticsResult::GamepadHapticsResultComplete);
+}
+
+void XRInputSource::StartHapticEffect(uint32_t effect_id,
+                                      float amplitude,
+                                      base::TimeDelta duration) {
+  if (effect_id == haptic_effect_id_) {
+    SendHapticFeedback(amplitude, duration);
+  }
+}
+
+void XRInputSource::OnHapticEffectEnded(uint32_t effect_id) {
+  if (effect_id == haptic_effect_id_ && pending_haptic_callback_) {
+    std::move(pending_haptic_callback_)
+        .Run(device::mojom::GamepadHapticsResult::GamepadHapticsResultComplete);
+  }
+}
+
+void XRInputSource::SendHapticFeedback(float amplitude,
+                                       base::TimeDelta duration) {
+  if (session_->ended()) {
+    return;
+  }
+  session_->xr()->frameProvider()->ApplyHapticFeedback(
+      session_, source_id(), amplitude, duration);
+}
