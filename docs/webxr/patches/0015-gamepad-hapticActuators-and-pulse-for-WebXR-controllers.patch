+
+ScriptPromise<IDLBoolean> GamepadHapticActuator::pulse(
+    ScriptState* script_state,
+    double value,
+    double duration) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLBoolean>>(script_state);
+  auto promise = resolver->Promise();
+
+  // Quest's browser clamps rather than rejecting; so do we.
+  value = std::clamp(value, 0.0, 1.0);
+  duration = std::clamp(duration, 0.0,
+                        device::GamepadHapticActuator::kMaxEffectDurationMillis);
+
+  // Like playEffect, a new pulse replaces the effect playing.
+  should_reset_ = false;
+
+  PlayVibrationEffectOnce(
+      GamepadHapticEffectType::GamepadHapticEffectTypeDualRumble,
+      device::mojom::blink::GamepadEffectParameters::New(
+          duration, /*start_delay=*/0, /*strong_magnitude=*/value,
+          /*weak_magnitude=*/value, /*left_trigger=*/0, /*right_trigger=*/0),
+      BindOnce(&GamepadHapticActuator::OnPulseCompleted, WrapPersistent(this),
+               WrapPersistent(resolver)));
+
+  return promise;
+}
+
+void GamepadHapticActuator::PlayVibrationEffectOnce(
+    GamepadHapticEffectType type,
+    device::mojom::blink::GamepadEffectParametersPtr params,
+    ResultCallback callback) {
   if (delegate_) {
-    delegate_->PlayVibrationEffectOnce(EffectTypeFromEnum(type.AsEnum()),
-                                       std::move(effect_params),
+    delegate_->PlayVibrationEffectOnce(type, std::move(params),
                                        std::move(callback));
   } else {
     gamepad_dispatcher_->PlayVibrationEffectOnce(
-        pad_index_, EffectTypeFromEnum(type.AsEnum()),
-        std::move(effect_params), std::move(callback));
+        pad_index_, type, std::move(params), std::move(callback));
   }
+}
 
-  return promise;
+void GamepadHapticActuator::OnPulseCompleted(
+    ScriptPromiseResolver<IDLBoolean>* resolver,
+    device::mojom::GamepadHapticsResult result) {
+  if (result == GamepadHapticsResult::GamepadHapticsResultComplete) {
+    ScheduleResetIfNotPreempted();
+  }
+  // A preempted pulse did play, until the next effect took over.
+  resolver->Resolve(
+      result == GamepadHapticsResult::GamepadHapticsResultComplete ||
+      result == GamepadHapticsResult::GamepadHapticsResultPreempted);
 }
 
 void GamepadHapticActuator::OnPlayEffectCompleted(
@@ -152,28 +201,32 @@ void GamepadHapticActuator::OnPlayEffectCompleted(
     resolver->Reject();
     return;
   } else if (result == GamepadHapticsResult::GamepadHapticsResultComplete) {
-    should_reset_ = true;
-    ExecutionContext* context = GetExecutionContext();
-    if (context) {
-      // Post a delayed task to stop vibration. The task will be run after all
-      // callbacks have run for the effect Promise, and may be ignored by
-      // setting |should_reset_| to false. The intention is to only stop
-      // vibration if the user did not chain another vibration effect in the
-      // Promise callback.
-      context->GetTaskRunner(TaskType::kMiscPlatformAPI)
-          ->PostTask(
-              FROM_HERE,
-              BindOnce(&GamepadHapticActuator::ResetVibrationIfNotPreempted,
-                       WrapPersistent(this)));
-    } else {
-      // The execution context is gone, meaning no new effects can be issued by
-      // the page. Stop vibration without waiting for Promise callbacks.
-      ResetVibrationIfNotPreempted();
-    }
+    ScheduleResetIfNotPreempted();
   }
   resolver->Resolve(ResultToV8(result));
 }
 
+void GamepadHapticActuator::ScheduleResetIfNotPreempted() {
+  should_reset_ = true;
+  ExecutionContext* context = GetExecutionContext();
+  if (context) {
+    // Post a delayed task to stop vibration. The task will be run after all
+    // callbacks have run for the effect Promise, and may be ignored by
+    // setting |should_reset_| to false. The intention is to only stop
+    // vibration if the user did not chain another vibration effect in the
+    // Promise callback.
+    context->GetTaskRunner(TaskType::kMiscPlatformAPI)
+        ->PostTask(
+            FROM_HERE,
+            BindOnce(&GamepadHapticActuator::ResetVibrationIfNotPreempted,
+                     WrapPersistent(this)));
+  } else {
+    // The execution context is gone, meaning no new effects can be issued by
+    // the page. Stop vibration without waiting for Promise callbacks.
+    ResetVibrationIfNotPreempted();
+  }
+}
+
 void GamepadHapticActuator::ResetVibrationIfNotPreempted() {
   if (should_reset_) {
     should_reset_ = false;
