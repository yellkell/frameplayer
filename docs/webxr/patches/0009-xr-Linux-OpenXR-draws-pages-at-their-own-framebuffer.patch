+constexpr VkImageUsageFlags kIntermediateUsage =
+    VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+    VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+
+// The size the page draws at: the framebuffer size it reported through
+// UpdateLayerBounds, which is not the swapchain's when it asked for a
+// framebufferScaleFactor other than the default. Until it reports one, the
+// swapchain's.
+gfx::Size GetPageImageSize(OpenXrCompositionLayer& layer) {
+  const gfx::Size size = layer.GetTransferSize();
+  return size.IsEmpty() ? layer.GetSwapchainImageSize() : size;
+}
