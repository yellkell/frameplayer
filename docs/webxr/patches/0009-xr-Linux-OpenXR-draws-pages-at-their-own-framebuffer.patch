 bool OpenXrGraphicsBindingVulkan::SupportsLayers() const {
@@ -379,9 +400,37 @@ void OpenXrGraphicsBindingVulkan::ResizeSharedBuffer(
     OpenXrCompositionLayer& layer,
     OpenXrSwapchainInfo& swap_chain_info,
     gpu::SharedImageInterface* sii) {
-  // Re-create all shared images for the layer at the new size.
-  DestroyIntermediateImages();
-  CreateSharedImages(layer, sii);
+  if (!vulkan_ || !vulkan_->has_external_memory_fd() ||
+      intermediate_images_.empty()) {
+    return;
+  }
+  base::span<OpenXrSwapchainInfo> swapchain_images = layer.GetSwapchainImages();
+  const size_t index =
+      static_cast<size_t>(&swap_chain_info - swapchain_images.data());
+  if (index >= intermediate_images_.size()) {
+    return;
+  }
+  // Blink attaches the shared image to a framebuffer whose depth buffer has
+  // the page's framebuffer size; at any other size the framebuffer is
+  // incomplete and the page draws nothing (framebufferScaleFactor 0.82: black).
+  const gfx::Size size = GetPageImageSize(layer);
+  if (intermediate_images_[index].size == size) {
+    return;
+  }
+
+  // Replace only this slot. Its previous image is idle: CopyToSwapchainImage
+  // waited for the last blit from it.
+  if (swap_chain_info.shared_image) {
+    swap_chain_info.shared_image->UpdateDestructionSyncToken(
+        swap_chain_info.sync_token);
+    swap_chain_info.shared_image.reset();
+  }
+  vulkan_->DestroyIntermediateImage(intermediate_images_[index]);
+  intermediate_images_[index] = {};
+  if (!CreateIntermediateImage(layer, index, size, sii)) {
+    DLOG(ERROR) << __func__ << ": no " << size.ToString() << " image for slot "
+                << index;
+  }
 }
 
