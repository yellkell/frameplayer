+++ b/device/vr/openxr/openxr_graphics_binding.h
@@ -138,6 +138,12 @@ class OpenXrGraphicsBinding {
   virtual void OnSwapchainImageReady(OpenXrCompositionLayer& layer,
                                      gpu::SharedImageInterface* sii) = 0;
 
+  // Called before `layer`'s swapchain is destroyed (also when the session
+  // ends). OpenXR requires all GPU work that uses the swapchain's images to
+  // have finished by then, so bindings that don't wait for their copies into
+  // it must wait here.
+  virtual void OnSwapchainDestroying(OpenXrCompositionLayer& layer) {}
