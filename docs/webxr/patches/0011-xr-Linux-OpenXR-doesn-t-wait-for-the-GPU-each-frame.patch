+void OpenXrVulkanContext::WaitForImage(IntermediateImage& image) {
+  if (!image.copy_pending) {
+    return;
+  }
+  vkWaitForFences(vk_device_, 1, &image.copy_fence, VK_TRUE, UINT64_MAX);
+  image.copy_pending = false;
+  if (image.wait_semaphore != VK_NULL_HANDLE) {
+    vkDestroySemaphore(vk_device_, image.wait_semaphore, nullptr);
+    image.wait_semaphore = VK_NULL_HANDLE;
+  }
