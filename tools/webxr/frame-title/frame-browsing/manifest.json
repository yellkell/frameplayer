{
  "manifest_version": 3,
  "name": "Steam Frame browsing",
  "version": "1.2",
  "description": "Scrolls what the pointer is over with a controller's thumbstick, shows controllers instead of generic hands in VR video players, and lets DeoVR's web player open in VR.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "xr-state.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "scroll.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "video-controllers.js"
      ]
    },
    {
      "matches": [
        "*://deovr.com/*",
        "*://*.deovr.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "deovr.js"
      ]
    }
  ]
}
