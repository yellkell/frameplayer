{
  "manifest_version": 3,
  "name": "Steam Frame browsing",
  "version": "1.0",
  "description": "Scrolls what the pointer is over with a controller's thumbstick.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["xr-state.js"]
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["scroll.js"]
    }
  ]
}
