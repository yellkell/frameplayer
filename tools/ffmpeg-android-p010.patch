diff -ru a/libavcodec/mediacodec_sw_buffer.c b/libavcodec/mediacodec_sw_buffer.c
--- a/libavcodec/mediacodec_sw_buffer.c	2026-10-26 17:31:43.953008600 +0000
+++ b/libavcodec/mediacodec_sw_buffer.c	2026-10-26 17:31:44.043954500 +0000
@@ -178,6 +178,38 @@
 
 
 
+/* 10-bit output (FramePlayer): like the 8-bit semi-planar copy, with two
+ * bytes per sample, each value in the high bits of a little-endian word. */
+void ff_mediacodec_sw_buffer_copy_p010(AVCodecContext *avctx,
+                                       MediaCodecDecContext *s,
+                                       uint8_t *data,
+                                       size_t size,
+                                       FFAMediaCodecBufferInfo *info,
+                                       AVFrame *frame)
+{
+    int i, j;
+
+    for (i = 0; i < 2; i++) {
+        int height = i == 0 ? avctx->height : (avctx->height + 1) / 2;
+        int width = FFMIN(FFALIGN(avctx->width, 2) * 2, frame->linesize[i]);
+        uint8_t *src = data + info->offset;
+        uint8_t *dst = frame->data[i];
+
+        if (i == 1)
+            src += s->slice_height * s->stride;
+        src += s->crop_top * s->stride;
+        src += s->crop_left * 2;
+
+        for (j = 0; j < height; j++) {
+            if (src + width > data + size)
+                break;
+            memcpy(dst, src, width);
+            src += s->stride;
+            dst += frame->linesize[i];
+        }
+    }
+}
+
 void ff_mediacodec_sw_buffer_copy_yuv420_packed_semi_planar(AVCodecContext *avctx,
                                                             MediaCodecDecContext *s,
                                                             uint8_t *data,
